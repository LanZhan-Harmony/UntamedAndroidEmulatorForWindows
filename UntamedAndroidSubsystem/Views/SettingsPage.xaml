<?xml version="1.0" encoding="utf-8" ?>
<Page
  x:Class="UntamedAndroidSubsystem.Views.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:UntamedAndroidSubsystem.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
>
  <Grid Margin="56,44,56,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <TextBlock x:Uid="Settings1" Style="{StaticResource TitleTextBlockStyle}" />
    </Grid>
    <StackPanel
      Grid.Row="1"
      MaxWidth="820"
      Margin="0,32,0,0"
      HorizontalAlignment="Left"
      Spacing="14"
    >
      <TextBlock x:Uid="Settings_HyperVApiHeader" FontSize="18" FontWeight="SemiBold" />
      <TextBlock x:Uid="Settings_HyperVApiSummary" TextWrapping="WrapWholeWords" />
      <TextBlock
        x:Uid="Settings_HyperVApiEvidence"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        TextWrapping="WrapWholeWords"
      />
    </StackPanel>
  </Grid>
</Page>
